    {
      "parameters": {
        "jsCode": "let text = ($input.first().json.output) || '';\n\n// Remove the machine-readable FILE: lines (they are sent as real attachments)\ntext = text.replace(/^\\s*FILE:\\s*.+\\|\\s*\\S+\\s*$/gim, '');\n\n// Strip markdown that breaks Telegram plain-text parsing\ntext = text.replace(/\\*\\*/g, '');\ntext = text.replace(/\\*/g, '');\ntext = text.replace(/__/g, '');\ntext = text.replace(/_/g, '');\ntext = text.replace(/`/g, '');\ntext = text.replace(/~~/g, '');\ntext = text.replace(/\\[(.*?)\\]\\((.*?)\\)/g, '$1: $2');  // [text](url) -> \"text: url\"\ntext = text.replace(/\\n{3,}/g, '\\n\\n').trim();\n\nif (!text) text = '\\u{1F4CE}';  // attachment-only reply: send a paperclip so the message isn't empty\nreturn [{ json: { output: text } }];\n"
      },
      "id": "format-text",
      "name": "Format Text",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        820,
        440
      ]
    },
    {

      "id": "send-text",
      "name": "Send a text message",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        1060,
        440
      ],
      "webhookId": "dfa7b7e0-13de-48b8-bfa5-69eedf79d4a5",
      "credentials": {
        "telegramApi": {
          "id": "CH4V7DqZfevDTkxY",
          "name": "TCY Arise"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Pull \"FILE: Label | URL\" lines from the agent answer and emit one item per file.\nconst out = ($input.first().json.output) || '';\nconst chatId = $('Edit Fields').first().json.chatId;\nconst items = [];\nconst re = /^\\s*FILE:\\s*(.+?)\\s*\\|\\s*(\\S+)\\s*$/gim;\nlet m;\nconst seen = new Set();\nwhile ((m = re.exec(out)) !== null) {\n  const label = m[1].trim();\n  let url = m[2].trim().replace(/[)>\\].,;]+$/, ''); // trim trailing punctuation\n  if (!/^https?:\\/\\//i.test(url) || seen.has(url)) continue;\n  seen.add(url);\n\n  // Normalise Google Drive share links to a direct-download URL\n  let downloadUrl = url;\n  if (/drive\\.google\\.com/i.test(url)) {\n    const id = (url.match(/\\/d\\/([\\w-]{20,})/) || [])[1] || (url.match(/[?&]id=([\\w-]{20,})/) || [])[1];\n    if (id) downloadUrl = `https://drive.usercontent.google.com/download?id=${id}&export=download`;\n  }\n\n  const path = url.split('?')[0].toLowerCase();\n  const isImage = /\\.(jpg|jpeg|png|webp|gif|bmp)$/.test(path) || /\\bphoto|image|img|gambar\\b/i.test(label);\n  items.push({ json: { chatId, label, url, downloadUrl, kind: isImage ? 'photo' : 'document' } });\n}\nreturn items;\n"
      },

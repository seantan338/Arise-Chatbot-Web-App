    {
      "parameters": {
        "jsCode": "let text = ($input.first().json.output) || '';\n// 1) escape HTML special chars\ntext = text.split('&').join('&amp;').split('<').join('&lt;').split('>').join('&gt;');\n// 2) FILE: Label | URL  ->  clickable (in case the model uses that format)\ntext = text.split('\\n').map(function (line) {\n  const t = line.trim();\n  if (t.toUpperCase().indexOf('FILE:') === 0) {\n    const rest = t.slice(5);\n    const bar = rest.indexOf('|');\n    if (bar !== -1) {\n      const label = rest.slice(0, bar).trim() || 'File';\n      const url = rest.slice(bar + 1).trim();\n      if (url) return '\\uD83D\\uDCCE <a href=\"' + url + '\">' + label + '</a>';\n    }\n  }\n  return line;\n}).join('\\n');\n// 3) Markdown [text](url) -> <a>\ntext = text.replace(/\\[([^\\]]+)\\]\\(([^)]+)\\)/g, '<a href=\"$2\">$1</a>');\n// 4) autolink any bare http(s) URL not already inside a tag\ntext = text.replace(/(^|[\\s(])(https?:\\/\\/[^\\s<]+)/g, '$1<a href=\"$2\">$2</a>');\n// 5) **bold** / __bold__ / *italic*\ntext = text.replace(/\\*\\*([^*]+)\\*\\*/g, '<b>$1</b>');\ntext = text.replace(/__([^_]+)__/g, '<b>$1</b>');\ntext = text.replace(/\\*([^*]+)\\*/g, '<i>$1</i>');\n// tidy blank lines\nwhile (text.indexOf('\\n\\n\\n') !== -1) text = text.split('\\n\\n\\n').join('\\n\\n');\ntext = text.trim();\nreturn [{ json: { output: text } }];"
      },

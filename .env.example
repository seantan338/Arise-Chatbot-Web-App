# ─────────────────────────────────────────────────────────────
# Arise PropertyBot — Web UI configuration
# Copy this file to ".env" and fill in the values, then restart `npm run dev`.
# NOTE: anything prefixed VITE_ is bundled into the browser build and is
# therefore PUBLIC. Do not put real API secrets here — only the n8n webhook
# URL (which should be protected on the n8n side) and the shared passcode.
# ─────────────────────────────────────────────────────────────

# The POST URL of the "Arise Chatbot — Web" n8n workflow's Webhook node.
# Production example: https://n8n.yourdomain.com/webhook/arise-web-chat
# Test example:       https://n8n.yourdomain.com/webhook-test/arise-web-chat
VITE_N8N_WEBHOOK_URL=

# Shared passcode agents type to unlock the chat (phase 1 access control).
# Leave blank to disable the gate entirely (not recommended).
VITE_ACCESS_CODE=arise2025

# Optional cosmetic overrides
VITE_BOT_NAME=Arise PropertyBot
VITE_AGENCY_NAME=Arise Real Estate
